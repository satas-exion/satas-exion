/* ==============================
SATAS EXION — MAIN STYLESHEET
============================== */

:root {
--background: #f7f7f5;
--surface: #ffffff;
--primary: #172554;
--accent: #d4a843;
--text: #202124;
--muted: #6b7280;
--border: #e5e7eb;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

html {
scroll-behavior: smooth;
}

body {
font-family: Arial, Helvetica, sans-serif;
background: var(--background);
color: var(--text);
line-height: 1.7;
}

header {
background: var(--surface);
padding: 24px 7%;
border-bottom: 1px solid var(--border);
}

header h1 {
color: var(--primary);
font-size: 1.8rem;
letter-spacing: 2px;
}

header p {
color: var(--muted);
font-size: 0.95rem;
}

main {
width: min(100% - 40px, 1000px);
margin: 70px auto;
}

main h2 {
color: var(--primary);
font-size: clamp(2rem, 5vw, 3.5rem);
line-height: 1.2;
margin-bottom: 24px;
}

main p {
max-width: 650px;
margin-bottom: 28px;
color: var(--muted);
}

button {
border: none;
border-radius: 8px;
padding: 14px 22px;
margin: 0 10px 10px 0;
font-size: 1rem;
font-weight: bold;
cursor: pointer;
transition: 0.2s ease;
}

button:first-of-type {
background: var(--primary);
color: white;
}

button:last-of-type {
background: var(--accent);
color: #172033;
}

button:hover {
transform: translateY(-2px);
opacity: 0.9;
}

footer {
text-align: center;
padding: 24px;
border-top: 1px solid var(--border);
color: var(--muted);
font-size: 0.9rem;
}

@media (max-width: 600px) {
header {
padding: 20px;
}

main {
    margin: 48px auto;
}

button {
    width: 100%;
    margin-right: 0;
}

}
