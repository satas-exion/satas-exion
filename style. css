/* ==============================
SATAS EXION — MAIN STYLESHEET
============================== */

:root {
--background: #f7f7f5;
--surface: #ffffff;
--primary: #172554;
--accent: #d4a843;
--text: #202124;
--muted: #6b7280;
--border: #e5e7eb;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

html {
scroll-behavior: smooth;
}

body {
font-family: Arial, Helvetica, sans-serif;
background: var(--background);
color: var(--text);
line-height: 1.7;
}

header {
background: var(--surface);
padding: 24px 7%;
border-bottom: 1px solid var(--border);
}

header h1 {
color: var(--primary);
font-size: 1.8rem;
letter-spacing: 2px;
}

header p {
color: var(--muted);
font-size: 0.95rem;
}

main {
width: min(100% - 40px, 1000px);
margin: 70px auto;
}

main h2 {
color: var(--primary);
font-size: clamp(2rem, 5vw, 3.5rem);
line-height: 1.2;
margin-bottom: 24px;
}

main p {
max-width: 650px;
margin-bottom: 28px;
color: var(--muted);
}

.button {
display: inline-flex;
align-items: center;
justify-content: center;
min-height: 52px;
padding: 14px 26px;
margin: 8px 10px 8px 0;

border: 1px solid transparent;
border-radius: 8px;

font-family: inherit;
font-size: 15px;
font-weight: 700;
text-align: center;
text-decoration: none;

cursor: pointer;
transition:
    background-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;

}

.button-primary {
background-color: var(--primary);
color: #ffffff;
box-shadow: 0 4px 12px rgba(23, 37, 84, 0.15);
}

.button-secondary {
background-color: var(--accent);
color: #172033;
box-shadow: 0 4px 12px rgba(212, 168, 67, 0.15);
}

.button-primary:hover {
background-color: #243b78;
box-shadow: 0 7px 18px rgba(23, 37, 84, 0.22);
transform: translateY(-2px);
}

.button-secondary:hover {
background-color: #e2ba5c;
box-shadow: 0 7px 18px rgba(212, 168, 67, 0.22);
transform: translateY(-2px);
}

.button:focus-visible {
outline: 3px solid #6b8cff;
outline-offset: 4px;
}

@media (max-width: 600px) {
.button {
display: flex;
width: 100%;
margin: 10px 0;
}
}

footer {
text-align: center;
padding: 24px;
border-top: 1px solid var(--border);
color: var(--muted);
font-size: 0.9rem;
}

@media (max-width: 600px) {
    header {
        padding: 20px;
    }

    main {
        margin: 48px auto;
    }

    .button {
        display: flex;
        width: 100%;
        text-align: center;
        margin: 10px 0;
    }
}

}
